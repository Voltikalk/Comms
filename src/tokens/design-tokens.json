{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Comms Design System Tokens",
  "version": "2.0.0",
  "colors": {
    "primary": {
      "50": "#EBF3FF",
      "100": "#D6E7FF",
      "200": "#ADCFFF",
      "300": "#70AFFF",
      "400": "#3385FF",
      "500": "#0066FF",
      "600": "#0052CC",
      "700": "#003D99",
      "800": "#002966",
      "900": "#001433",
      "950": "#000A1A",
      "DEFAULT": "#0066FF"
    },
    "secondary": {
      "50": "#F5EBFF",
      "100": "#EBD6FF",
      "200": "#D6ADFF",
      "300": "#B870FF",
      "400": "#A347FF",
      "500": "#9933FF",
      "600": "#7A24D4",
      "700": "#5C17A3",
      "800": "#3D0A70",
      "900": "#1F033D",
      "950": "#0F011F",
      "DEFAULT": "#9933FF"
    },
    "success": {
      "50": "#E6FAF2",
      "100": "#CCF5E6",
      "200": "#99EBCD",
      "300": "#66E0B3",
      "400": "#33D69A",
      "500": "#00D084",
      "600": "#00A66A",
      "700": "#007D50",
      "800": "#005335",
      "900": "#002A1B",
      "950": "#00150D",
      "DEFAULT": "#00D084"
    },
    "error": {
      "50": "#FFEBEB",
      "100": "#FFD6D6",
      "200": "#FFADAD",
      "300": "#FF7070",
      "400": "#FF4747",
      "500": "#FF3333",
      "600": "#CC2424",
      "700": "#991717",
      "800": "#660A0A",
      "900": "#330303",
      "950": "#1A0101",
      "DEFAULT": "#FF3333"
    },
    "surface": {
      "dark": {
        "base": "#0E1621",
        "card": "#17212B",
        "cardElevated": "#242F3D",
        "input": "#0E1621",
        "border": "rgba(255, 255, 255, 0.12)",
        "textPrimary": "#FFFFFF",
        "textSecondary": "#8E9BA8"
      },
      "light": {
        "base": "#F5F7FF",
        "card": "rgba(255, 255, 255, 0.85)",
        "cardElevated": "#FFFFFF",
        "input": "rgba(255, 255, 255, 0.9)",
        "border": "rgba(0, 102, 255, 0.15)",
        "textPrimary": "#1A1A1A",
        "textSecondary": "#64748B"
      }
    }
  },
  "typography": {
    "fontFamilies": {
      "heading": "Montserrat, Inter, -apple-system, sans-serif",
      "body": "Inter, -apple-system, BlinkMacSystemFont, sans-serif",
      "mono": "JetBrains Mono, monospace"
    },
    "fontSizes": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px",
      "4xl": "36px"
    },
    "fontWeights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px"
  },
  "radii": {
    "sm": "8px",
    "md": "12px",
    "lg": "14px",
    "xl": "18px",
    "2xl": "20px",
    "3xl": "24px",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 2px 8px rgba(0, 102, 255, 0.08)",
    "md": "0 6px 20px -2px rgba(0, 102, 255, 0.4)",
    "lg": "0 16px 40px rgba(0, 30, 100, 0.2)",
    "glow": "0 0 25px rgba(153, 51, 255, 0.5)",
    "success": "0 8px 25px rgba(0, 208, 132, 0.45)"
  },
  "animation": {
    "durations": {
      "instant": "100ms",
      "fast": "200ms",
      "normal": "350ms",
      "slow": "600ms",
      "shimmer": "1500ms"
    },
    "easings": {
      "natural": [0.4, 0, 0.2, 1],
      "smooth": [0.16, 1, 0.3, 1],
      "springBounce": [0.34, 1.56, 0.64, 1]
    }
  }
}
