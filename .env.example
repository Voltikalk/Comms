# ==============================================================================
# Secure Comms — Environment Configuration Template
# Copy this file to .env or .env.local and populate with your actual credentials.
# ==============================================================================

# Server & Networking
PORT=3001
NODE_ENV=development
HOST=0.0.0.0

# Frontend URLs & CORS
VITE_SERVER_URL=http://localhost:3001
CLIENT_ORIGIN=http://localhost:5173

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT & Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database (MongoDB fallback / archival)
MONGODB_URI=mongodb://127.0.0.1:27017/comms_db

# WebRTC & Media Relay (Optional STUN / TURN servers)
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
